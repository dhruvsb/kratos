# Copy to .env and fill in from your Supabase project (Settings → API).
# The app reads these via app.config.ts. Never commit .env.
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=your-anon-key

# Used ONLY by node scripts (seed, import, RLS test) — never shipped to the client.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Phase 2 (voice logging). Used ONLY by node dev tools (npm run eval,
# npm run parse-cli) — never shipped to the client. The deployed edge
# function reads its own copy from a Supabase secret, not this file:
#   supabase secrets set OPENAI_API_KEY=sk-...
OPENAI_API_KEY=sk-your-openai-key

# Langfuse LLM observability (Phase 2). Set as Supabase secrets so the deployed
# transcribe + parse-utterance edge functions can trace every voice call. If these
# are unset, instrumentation is a safe no-op (the functions work unchanged):
#   supabase secrets set LANGFUSE_PUBLIC_KEY=pk-lf-...
#   supabase secrets set LANGFUSE_SECRET_KEY=sk-lf-...
#   supabase secrets set LANGFUSE_BASE_URL=https://cloud.langfuse.com   # or self-host URL
# Get the key pair from Langfuse → Settings → API Keys (free tier: cloud.langfuse.com).
LANGFUSE_PUBLIC_KEY=pk-lf-your-public-key
LANGFUSE_SECRET_KEY=sk-lf-your-secret-key
LANGFUSE_BASE_URL=https://cloud.langfuse.com

# LLM-as-judge faithfulness eval (optional): after a parse, an extra LLM call grades
# whether the parse faithfully matches the transcript (0–1), attached to the Langfuse
# trace as a `faithfulness` score. Runs in the background (never adds parse latency)
# and only when Langfuse is enabled. It costs one extra LLM call per judged parse, so
# it is OFF until you set a sample rate. Set as Supabase secrets on parse-utterance:
#   supabase secrets set FAITHFULNESS_JUDGE_SAMPLE_RATE=1.0     # 1.0=every parse, 0.2=20%, 0=off
#   supabase secrets set FAITHFULNESS_JUDGE_MODEL=gpt-5.6-luna  # optional; must be priced in prices.ts
FAITHFULNESS_JUDGE_SAMPLE_RATE=0
FAITHFULNESS_JUDGE_MODEL=gpt-5.6-luna
